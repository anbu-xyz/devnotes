<config
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3
        http://www.ehcache.org/schema/ehcache-core-3.9.xsd">

    <!-- Enable disk persistence for the CacheManager -->
    <persistence directory="ehcache-data/"/>

    <cache alias="durableCache">  <!-- Use this name in @Cacheable("durableCache") -->
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>  <!-- Flexible for any value -->

        <resources>
            <!-- Persistent disk tier: durable, survives restarts -->
            <disk unit="MB" persistent="true">1024</disk>
        </resources>
    </cache>

</config>